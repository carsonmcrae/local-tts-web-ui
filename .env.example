# Purpose: Documented example of every server setting (copy to `.env` only if you need to change one).
# Scope: LTTS_* variables read by apps/server/src/ltts/config.py. All values below are the defaults.
# Does NOT belong: Secrets — this app needs none. Never commit a real `.env`.

# Where documents, voice recordings, audio cache and the database live (git-ignored).
# LTTS_DATA_DIR=./data
# LTTS_MODELS_DIR=./data/models
# LTTS_ENGINES_DIR=./data/engines

# Network exposure: loopback only by default. Prefer `ltts serve --allow-network`, which generates a token.
# LTTS_HOST=127.0.0.1
# LTTS_ALLOW_NETWORK=false
# LTTS_ACCESS_TOKEN=            # at least 24 characters; required for non-loopback clients
# LTTS_EXTRA_ALLOWED_HOSTS=[]   # JSON list, e.g. ["mybox.local"]

# Document limits (enforced on the server).
# LTTS_MAX_UPLOAD_MB=25
# LTTS_MAX_TEXT_CHARS=2000000
# LTTS_MAX_PDF_PAGES=2000
# LTTS_MAX_ARCHIVE_ENTRIES=5000
# LTTS_MAX_ARCHIVE_UNCOMPRESSED_MB=300
# LTTS_MAX_COMPRESSION_RATIO=200
# LTTS_EXTRACTION_TIMEOUT_S=90
# LTTS_EXTRACTION_MEMORY_MB=1536   # Linux only (RLIMIT_AS)
# LTTS_MAX_CONCURRENT_EXTRACTIONS=2
# LTTS_MAX_DOCUMENTS=500

# Audio, storage and voices.
# LTTS_AUDIO_CACHE_MAX_MB=2048
# LTTS_MIN_FREE_DISK_MB=500
# LTTS_MAX_VOICE_REFERENCE_S=60
# LTTS_MAX_VOICE_PROFILES=50

# Engines.
# LTTS_WARM_UP_ENGINES=true
# LTTS_CLONE_WORKER_IDLE_UNLOAD_S=600

# Bootstrap (Node scripts). These are NOT read from .env: set them as environment variables.
# LTTS_SKIP_MODEL_DOWNLOAD=0   # 1 = don't download the Kokoro model during setup
# LTTS_NO_OPEN=0               # 1 = don't open a browser on `npm run dev`
# LTTS_API_PORT=8765
# LTTS_WEB_PORT=5173
# LTTS_UV_PATH=                # use a specific uv binary
# LTTS_UV_PINNED_ONLY=0        # 1 = ignore a system uv and use the pinned, verified download
