{
  "threshold": 0,
  "minLines": 5,
  "minTokens": 50,
  "format": ["typescript", "tsx", "javascript", "python", "css", "yaml", "markup"],
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/dist/**",
    "**/coverage/**",
    ".claude/**",
    ".tools/**",
    "data/**",
    "**/*.lock",
    "**/package-lock.json",
    "apps/web/src/api/schema.gen.ts",
    "docs/research/sound-effects-listening.html",
    "tests/fixtures/**",
    "apps/desktop/runtime/**",
    "apps/desktop/src-tauri/target/**"
  ],
  "reporters": ["console", "json"],
  "output": ".tools/jscpd",
  "absolute": false
}
