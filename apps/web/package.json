{
  "//": "Purpose: The React web UI package. Scope: Runtime UI dependencies and web-only scripts (vite, vitest). Does NOT belong: Repository-wide tooling (root package.json).",
  "name": "@ltts/web",
  "version": "2.0.0",
  "author": "Carson McRae",
  "homepage": "https://github.com/carsonmcrae/ttsnative",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsonmcrae/ttsnative.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
