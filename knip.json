{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/media/demo-page.js",
        "scripts/media/promo/promo.js",
        "site/demo.js",
        "apps/desktop/splash/splash.js",
        "scripts/release/*.mjs",
        "scripts/desktop/*.mjs",
        "scripts/**/*.test.mjs"
      ],
      "ignoreDependencies": ["vite", "@tauri-apps/cli"]
    },
    "apps/web": {
      "ignore": ["src/api/schema.gen.ts"],
      "entry": ["public/audio/capture-worklet.js", "public/sw.js"]
    }
  },
  "ignoreUnresolved": ["../../.tools/server-requirements.txt"]
}
